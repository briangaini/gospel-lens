// Firestore security rules for The Gospel Lens (added 2026-09-07).
//
// This file is NOT auto-deployed -- there's no Firebase CLI wired into this
// project's build/deploy pipeline (everything else here deploys through
// Vercel, not Firebase Hosting). Brian pastes this into the Firebase
// console himself: Firestore Database -> Rules tab -> replace the contents
// -> Publish. Keep this file in sync with whatever's actually pasted there,
// the same way dist/404.html and NotFoundView are kept in sync manually.
//
// One document per signed-in user, at users/{uid} -- holds just
// savedPostIds and likedPostIds (see src/firebase.js). A user can only ever
// read or write their OWN document (request.auth.uid must match the
// document's id) -- nobody can read or overwrite another visitor's saved/
// liked list, signed in or not. Everything else in this database (there is
// nothing else) is denied by default.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
